# =============================================
# KANKA — Environment Variables
# =============================================
# Copy this file to .env.local and fill in values
# Never commit .env.local to version control

# =============================================
# SUPABASE (Required)
# =============================================
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================
# TELEGRAM BOT (Required for notifications)
# =============================================
# 1. Create bot via @BotFather on Telegram → get TOKEN
# 2. Add bot to your group/channel → get CHAT_ID
# NEVER expose these in frontend code!
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# =============================================
# ANALYTICS (Optional)
# =============================================
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# =============================================
# APP CONFIG
# =============================================
# Your production URL (for SEO canonical URLs)
NEXT_PUBLIC_APP_URL=https://kanka.uz

# =============================================
# SETUP INSTRUCTIONS
# =============================================
# 1. Copy: cp .env.example .env.local
# 2. Fill in SUPABASE values from dashboard
# 3. Fill in TELEGRAM values from BotFather
# 4. Run database migrations (see README.md)
# 5. npm run dev
